
# LLM配置 (从HelloAgents继承,如需覆盖可在此配置)
# 模型名称
LLM_MODEL_ID=your-model-name

# API密钥
LLM_API_KEY=your-api-key-here

# 服务地址
LLM_BASE_URL=your-api-base-url

# 普通模型请求等待时间；完整行程生成单独等待120秒
LLM_TIMEOUT=90

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志级别
LOG_LEVEL=INFO

# 测试模式开关
# true: 不调用 LLM，直接使用高德 Web API/内置真实景点生成行程，适合调试和演示
# false: 调用 HelloAgents + LLM + MCP 多智能体流程
TRIP_FAST_MODE=true

# Unsplash API Credentials
UNSPLASH_ACCESS_KEY=""
UNSPLASH_SECRET_KEY=""

# 高德地图API配置
AMAP_API_KEY=your_amap_api_key_here
